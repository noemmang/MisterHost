{# Página de error: el código HTTP va de título en la cabecera y debajo su mensaje. #}
{% extends 'base.html.twig' %}

{% block titulo %}{{ status }}{% endblock %}

{% block volver %}<a class="volver" href="/">{{ t('nav.volver') }}</a>{% endblock %}

{% block contenido %}
    <p>{{ mensaje }}</p>
{% endblock %}