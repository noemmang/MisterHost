{# Plantilla base: estructura común de todas las páginas. Cada vista rellena el título (que se muestra también en la cabecera), el contenido y, si lo necesita, el botón de volver y sus scripts. #}
<!DOCTYPE html>
<html lang="{{ idioma }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block titulo %}{% endblock %} - {{ t('app.nombre') }}</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
    <header class="cabecera">
        <a class="marca" href="/">{{ t('app.nombre') }}</a>
        <h1>{{ block('titulo') }}</h1>
        {% block volver %}{% endblock %}
    </header>

    <main>
        {% block contenido %}{% endblock %}
    </main>

    {% block scripts %}{% endblock %}
</body>
</html>