{# Detalle de una reserva: el resumen a la izquierda y el historial de eventos a la derecha. #}
{% extends 'base.html.twig' %}

{% block titulo %}{{ t('detalle.titulo') }}{% endblock %}

{% block volver %}<a class="volver" href="/">{{ t('nav.volver') }}</a>{% endblock %}

{% block contenido %}
    <div class="detalle">
        <section>
            <h2>{{ t('detalle.resumen') }}</h2>

            <dl class="datos">
                <dt>{{ t('reserva.id') }}</dt>
                <dd>{{ reserva.id }}</dd>

                <dt>{{ t('reserva.estado') }}</dt>
                <dd><span class="estado estado-{{ reserva.estado }}" data-estado>{{ t('reserva.estado.' ~ reserva.estado) }}</span></dd>

                <dt>{{ t('reserva.nombre_huesped') }}</dt>
                <dd>{{ reserva.nombre_huesped }}</dd>

                <dt>{{ t('reserva.email_huesped') }}</dt>
                <dd>{{ reserva.email_huesped }}</dd>

                <dt>{{ t('reserva.nombre_alojamiento') }}</dt>
                <dd>{{ reserva.nombre_alojamiento }}</dd>

                <dt>{{ t('reserva.fecha_entrada') }}</dt>
                <dd>{{ reserva.fecha_entrada|date('d/m/Y') }}</dd>

                <dt>{{ t('reserva.fecha_salida') }}</dt>
                <dd>{{ reserva.fecha_salida|date('d/m/Y') }}</dd>

                <dt>{{ t('reserva.importe') }}</dt>
                <dd>{{ reserva.importe|number_format(2, ',', '.') }} {{ t('reserva.moneda') }}</dd>

                {# Las notas son opcionales. #}
                {% if reserva.notas %}
                    <dt>{{ t('reserva.notas') }}</dt>
                    <dd class="notas">{{ reserva.notas }}</dd>
                {% endif %}

                <dt>{{ t('reserva.fecha_creacion') }}</dt>
                <dd>{{ reserva.fecha_creacion|date('d/m/Y H:i') }}</dd>
            </dl>

            {# Una reserva ya cancelada no se puede cancelar de nuevo, así que el botón va oculto. #}
            <button type="button" class="cancelar" data-accion="cancelar" data-id="{{ reserva.id }}"{% if reserva.estado == 'cancelada' %} hidden{% endif %}>{{ t('detalle.cancelar') }}</button>

            {# Avisos de carga, éxito y error que pinta el JS. #}
            <p class="aviso" role="status" data-aviso hidden></p>
        </section>

        <section>
            <h2>{{ t('detalle.historial') }}</h2>

            <ol class="timeline" data-historial>
                {% for evento in reserva.eventos %}
                    <li>
                        <time datetime="{{ evento.fecha_creacion }}">{{ evento.fecha_creacion|date('d/m/Y H:i') }}</time>
                        {{ evento.descripcion }}
                    </li>
                {% endfor %}
            </ol>
        </section>
    </div>

    {# Textos que necesita el JS: nombre del estado cancelada y mensajes. #}
    <div hidden data-textos
        data-cancelada="{{ t('reserva.estado.cancelada') }}"
        data-cargando="{{ t('mensaje.cargando') }}"
        data-error-red="{{ t('mensaje.error_red') }}"
        data-confirmar="{{ t('detalle.confirmar_cancelar') }}"
        data-cancelacion-ok="{{ t('mensaje.cancelacion_ok') }}"></div>
{% endblock %}

{% block scripts %}
    <script type="module" src="/js/detalle.js"></script>
{% endblock %}